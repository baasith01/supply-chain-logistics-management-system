# ==========================================
# Logistics & Supply Chain Configuration
# ==========================================

# -------------------------
# PostgreSQL
# -------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=logistics
POSTGRES_USER=logistics_user
POSTGRES_PASSWORD=logistics_password

# -------------------------
# Kafka
# -------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Kafka Topics
KAFKA_ORDERS_TOPIC=orders
KAFKA_GPS_TOPIC=gps_tracking
KAFKA_DELIVERY_TOPIC=delivery_updates
KAFKA_TRAFFIC_TOPIC=traffic_updates
KAFKA_WEATHER_TOPIC=weather_updates

# -------------------------
# AWS S3
# -------------------------
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=ap-south-1
S3_BUCKET_NAME=your-logistics-bucket

# -------------------------
# Weather API
# -------------------------
WEATHER_API_KEY=your_weather_api_key_here

# -------------------------
# Database Connection
# -------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=logistics
DB_USER=logistics_user
DB_PASSWORD=logistics_password

# -------------------------
# Spark
# -------------------------
SPARK_MASTER=local[*]

# -------------------------
# Airflow
# -------------------------
AIRFLOW_HOME=./airflow

# -------------------------
# Application
# -------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
